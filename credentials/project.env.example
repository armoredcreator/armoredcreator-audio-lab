# TEMPLATE ONLY — copy to credentials/project.env and fill private credentials locally.
# Never commit credentials/project.env.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
ARMORED_CREATOR_BOT_TOKEN=
GEMINI_API_KEY=
SHOPEE_APP_ID=
SHOPEE_SECRET_KEY=

ARMORED_REAL_TELEGRAM=1
ARMORED_HUB_DRY_RUN=0

# Audio Intelligence: only confidently identified Portuguese speech uses RVC.
# First speech item downloads/caches this small multilingual Whisper model.
ARMORED_AUDIO_LANGUAGE_MODEL=openai/whisper-tiny
ARMORED_AUDIO_LANGUAGE_SECONDS=8
ARMORED_AUDIO_LANGUAGE_MIN_CONFIDENCE=0.20

# Source 1 -> Hub topic 228
ARMORED_SOURCE_1_KEY=source1
ARMORED_SOURCE_1_CHAT_ID=-1003788989075
ARMORED_SOURCE_1_ID=-1003788989075
ARMORED_HUB_1_CHAT_ID=-1004341972306
ARMORED_HUB_1_TOPIC_ID=228

# Source 2 -> Hub topic 1160
ARMORED_SOURCE_2_KEY=source2
ARMORED_SOURCE_2_CHAT_ID=-1002698134896
ARMORED_SOURCE_2_ID=-1002698134896
ARMORED_HUB_2_CHAT_ID=-1004341972306
ARMORED_HUB_2_TOPIC_ID=1160

# Source 3 is known, but its destination topic must be confirmed before LIVE.
# Uncomment and fill ARMORED_HUB_3_TOPIC_ID only after confirming the real topic ID.
